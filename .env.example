# ── Database ─────────────────────────────────────────────────────
# SQLite file, relative to prisma/. For Postgres: set provider = "postgresql"
# in prisma/schema.prisma and use a postgres:// URL here.
DATABASE_URL="file:./dev.db"

# ── Discovery sources ────────────────────────────────────────────
# Google Places API (New). Optional but recommended: adds ratings, review
# counts and better coverage. Enable "Places API (New)" in Google Cloud and
# create an API key restricted to it.
GOOGLE_PLACES_API_KEY=

# OpenStreetMap (no key). Nominatim's usage policy asks for a contact address
# in the User-Agent; put an email you read here.
OSM_CONTACT_EMAIL=
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter

# ── AI (optional) ────────────────────────────────────────────────
# Used to interpret analyses and write outreach messages. Without it the app
# uses rule-based text and says so.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Website analysis ─────────────────────────────────────────────
# Google PageSpeed Insights API key (optional). Adds real mobile performance
# metrics (Lighthouse) to each analysis. Enable "PageSpeed Insights API" in
# Google Cloud and create an API key. Without it, speed is estimated from the
# HTML download time and labelled as such.
PAGESPEED_API_KEY=
# Development/testing only: allow analysing sites on localhost/private IPs.
# ANALYSIS_ALLOW_PRIVATE_HOSTS=false

# ── Outreach (optional) ──────────────────────────────────────────
# Name used to sign outreach messages and company shown as "Preparado por"
# on reports. Without them messages end with a "[Tu nombre]" placeholder.
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_COMPANY=

# ── Worker ───────────────────────────────────────────────────────
# Max background jobs running at once (discovery is always 1 at a time).
# JOB_CONCURRENCY=3
